# 复制为仓库根目录的 .env.local-research。只在私有副本填写。
# 必填：网站发件邮箱、邮箱客户端授权码、百炼工作空间 API key。
SMTP_USERNAME=
SMTP_AUTH_CODE=
BAILIAN_API_KEY=

# 同意用发件地址作为 arXiv 请求的公开联系人时留空，否则填写另一个地址。
ARXIV_CONTACT_EMAIL=
# QQ 和 163 可自动确定主机；其他邮箱填支持 SSL 465 的主机。
SMTP_HOST=
# 百炼默认使用 agent/.env.example 的模型和地址；工作空间有其他要求时填写。
MODEL_BASE_URL=
MODEL_NAME=
# tcloud env ls 中的环境名称，默认 acs-network-probe。
AGENT_TCLOUD_ENV_NAME=

# 网页作业通过本机代理搜索 arXiv。独立 Agent 也使用此 key。
TAVILY_API_KEY=
# Neon 填 postgresql://... 连接串；填 local 使用本机后端库中的 agt_baseline schema。
AGENT_DATABASE_URL=
# 网页研究同时保存解析文档与完整结果到 Agent 数据库。
AGENT_PERSIST=false
# Retrieval Extension 的 embedding 服务；留空沿用组件默认值或已有配置。
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=
