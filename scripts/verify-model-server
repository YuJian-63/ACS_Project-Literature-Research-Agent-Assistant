#!/usr/bin/env python3
"""Submit and verify the course Qwen service from a separate CPU job."""
import argparse
import json
import re
import shutil
import subprocess
import sys
import tempfile
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
LOG_NAMES = {"gpu": "qwen-public-serve-agent", "cpu": "qwen-agent-verify"}


def cli(*args, cwd=None, timeout=120):
    result = subprocess.run(["tcloud", *args], cwd=cwd, stdout=subprocess.PIPE,
                            stderr=subprocess.STDOUT, timeout=timeout)
    return result.returncode, result.stdout.decode(errors="replace").replace("\0", "").replace("\r", "")


def verify(keep_server):
    base = ROOT / "runtime" / "model-server"
    base.mkdir(parents=True, exist_ok=True)
    run = Path(tempfile.mkdtemp(prefix="run-", dir=base))
    print("验收记录", run, flush=True)
    record = {}
    active = {}

    def save():
        (run / "run.json").write_text(json.dumps(record, indent=2) + "\n")

    def submit(role, stage):
        record[role + "_submitted_at"] = int(time.time())
        save()
        _, output = cli("submit", cwd=stage, timeout=600)
        (run / (role + "-submit.log")).write_text(output)
        ids = set(re.findall(r"(?mi)^\s*Submitted batch job ([1-9][0-9]{0,19})\s*$", output))
        if len(ids) != 1:
            raise RuntimeError("无法确认 " + role + " 作业号，请检查提交日志和队列后再运行")
        job = ids.pop()
        active[role] = record[role + "_id"] = job
        save()
        print(role.upper(), job, flush=True)

    def queue(job):
        code, output = cli("ps", "-j", job)
        if "Invalid job id specified" in output:
            return "离队"
        if code or "[Tcloud Error]" in output or not re.search(r"(?m)^\s*JOBID\s", output):
            raise RuntimeError("查询队列失败：" + output[-500:])
        row = re.search(r"(?m)^\s*" + job + r"[ \t]+(.+)$", output)
        return row.group().strip() if row else "离队"

    def wait(role):
        job = active[role]
        path = "slurm_log/%s-%s.log" % (LOG_NAMES[role], job)
        departed = 0
        while True:
            state = queue(job)
            print(role.upper(), state, flush=True)
            code, log = cli("cat", path)
            if not code and "[Tcloud Error]" not in log:
                (run / (role + ".log")).write_text(log)
                start = re.search(r"(?m)^VERIFY_STARTED_AT=(\d+)$", log)
                if start:
                    started = int(start[1])
                    record[role + "_started_at"] = started
                    record[role + "_queue_seconds_estimate"] = started - record[role + "_submitted_at"]
                    save()
                if role == "cpu" and "MODEL_SERVER_VERIFY=PASS" in log.splitlines():
                    return
                url = re.search(r"(?m)^AGENT_BASE_URL=(http://[\w.-]+:8000/v1)$", log)
                if role == "gpu" and state != "离队" and url and all(marker in log for marker in (
                    "RUNTIME_MODE=public", "AGENT_TELEMETRY_READY=qwen-agent-telemetry-v1",
                    "Application startup complete.")):
                    now = int(time.time())
                    record.update(base_url=url[1], ready_observed_at=now)
                    if start:
                        record["load_seconds_estimate"] = now - int(start[1])
                    save()
                    print("AGENT_BASE_URL=" + url[1], flush=True)
                    return url[1]
            departed = departed + 1 if state == "离队" else 0
            if departed >= 2:
                active.pop(role)
                raise RuntimeError(role + " 作业已离队，未见验收标记。请查看 " + path)
            if role == "cpu" and state != "离队" and queue(active["gpu"]) == "离队":
                raise RuntimeError("CPU 验收期间 GPU 服务已结束")
            time.sleep(20)

    try:
        with tempfile.TemporaryDirectory() as tmp:
            # TCloud keys uploaded work directories by name. Isolate concurrent runs.
            for role, source in (("gpu", "server"), ("cpu", "client")):
                stage = Path(tmp) / (run.name + "-" + source)
                shutil.copytree(ROOT / "model-server" / source, stage,
                                ignore=shutil.ignore_patterns("__pycache__", ".DS_Store", "configurations", "run.sh"))
                if role == "cpu":
                    (stage / "server-url.txt").write_text(record["base_url"] + "\n")
                submit(role, stage)
                wait(role)
        record["result"] = "PASS"
        save()
        if keep_server:
            print("服务已保留。结束时运行 tcloud cancel -j", active.pop("gpu"))
        print("PASS", run / "run.json")
    finally:
        failures = []
        for role in ("cpu", "gpu"):
            if role not in active:
                continue
            job = active[role]
            try:
                code, output = cli("cancel", "-j", job)
                if (code or "[Tcloud Error]" in output) and queue(job) != "离队":
                    failures.append(job)
            except (OSError, RuntimeError, subprocess.TimeoutExpired):
                failures.append(job)
        if failures:
            raise RuntimeError("请手动检查并结束作业 " + ", ".join(failures))


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--keep-server", action="store_true", help="验收通过后保留 GPU 服务供 Agent 调用")
    try:
        verify(parser.parse_args().keep_server)
    except (RuntimeError, OSError, subprocess.TimeoutExpired, KeyboardInterrupt) as error:
        sys.exit("验收未正常结束。请核对本轮作业记录和队列。 " + str(error))
