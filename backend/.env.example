DATABASE_URL=postgresql+psycopg://literature:local-development-only@127.0.0.1:5432/literature
POSTGRES_DB=literature
POSTGRES_USER=literature
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=5432
STORAGE_ROOT=runtime/storage
TASK_MONITOR_ENABLED=true
PARSER_TIMEOUT_SECONDS=120
TASK_RUNNER=agent
# Research executes only through the independent Agent. Configure a transport before enabling dispatch.
AGENT_DISPATCH_ENABLED=false
# Empty: STORAGE_ROOT/agent-exchange; relative paths resolve from backend/.
AGENT_EXCHANGE_ROOT=
# Optional HTTPS address accessible from the job. Worker writes a private
# outbox/<dispatch_id>/library-access.json beside input.zip for the submitter.
AGENT_LIBRARY_PUBLIC_URL=
# manual: external exchange; local: Agent process; tcloud: course CPU jobs; tacc: SSH/Slurm.
AGENT_TRANSPORT=manual
# Course Worker runs an initialized SDK. Its private Bailian dotenv signs a
# temporary API key for each job. Omit when the cluster has a private model.env.
AGENT_TCLOUD_CLI=tcloud
AGENT_TCLOUD_ENV_NAME=acs-network-probe
# tcloud submit syncs files and updates the environment before invoking sbatch.
AGENT_TCLOUD_SUBMIT_TIMEOUT_SECONDS=180
AGENT_TCLOUD_MODEL_ENV_FILE=
# Local mode: paths relative to backend/. Agent uses its own Python 3.12 environment.
# Windows: ../agent/.venv/Scripts/python.exe; macOS/Linux: ../agent/.venv/bin/python
AGENT_LOCAL_ROOT=../agent
AGENT_LOCAL_PYTHON=
# TACC: preconfigured OpenSSH alias and absolute paths on the shared remote filesystem.
AGENT_TACC_HOST=
AGENT_TACC_HELPER=
AGENT_TACC_CONFIG=
# Optional absolute remote interpreter when login-node python3 is older than 3.11.
AGENT_TACC_PYTHON=python3
AGENT_TRANSPORT_TIMEOUT_SECONDS=30
# Cleanup is explicit; minimum retention is one day, default seven days.
AGENT_RETENTION_SECONDS=604800
AGENT_MAX_STEPS=100
# Unified research: additional searchable papers; selected + searched is capped at 20.
AGENT_SEARCH_MAX_PAPERS=5
AGENT_TIMEOUT_SECONDS=1800
AGENT_OUTPUT_TOKENS=8192
AGENT_CONTEXT_TOKENS=32000
AGENT_RESULT_MAX_BYTES=16777216
AGENT_POLL_SECONDS=2
ARXIV_ENABLED=false
ARXIV_CONTACT_EMAIL=
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Verified accounts: configure secrets privately before using protected APIs.
# Use the same hostname in the browser and backend; localhost and 127.0.0.1 differ.
FRONTEND_PUBLIC_URL=http://127.0.0.1:5173
# Local loopback HTTP only. HTTPS deployments require true and an HTTPS frontend origin.
AUTH_COOKIE_SECURE=false
AUTH_SESSION_TTL_SECONDS=604800
AUTH_VERIFY_TTL_SECONDS=86400
AUTH_RESET_TTL_SECONDS=1800
# Independent random secrets, each at least 32 UTF-8 bytes; no real values in this file.
AUTH_RATE_KEY=
AUTH_CSRF_KEY=

# QQ SMTP: SSL/TLS on 465; username and From must be the same QQ mailbox.
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USERNAME=
# QQ SMTP authorization code, never the mailbox login password.
SMTP_AUTH_CODE=
SMTP_FROM=
SMTP_TIMEOUT_SECONDS=15
# Independent Fernet key (URL-safe base64 encoding of 32 random bytes).
# Keep this stable while encrypted messages remain queued; see README.
MAIL_OUTBOX_KEY=

# Implemented per-user limits; see README for validation and acceptance status.
USER_ACTIVE_TASKS=2
USER_ACTIVE_IMPORTS=2
USER_DAILY_TASKS=20
