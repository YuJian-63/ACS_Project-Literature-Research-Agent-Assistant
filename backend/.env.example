# Copy to backend/.env and fill credentials only in that private file.
# API and Workers must share the same configuration. See README.md for setup.
# Configure credentials and transport paths before enabling optional features.

# 1. Database and storage
# Local development only: replace the password in both values for deployment.
DATABASE_URL=postgresql+psycopg://literature_assistance_system:literature_assistance_system@127.0.0.1:55432/literature_assistance_system
# Used only by compose.yaml; omit when using an existing database.
# When using Compose, match DATABASE_URL to the credentials and host port below.
POSTGRES_DB=literature_assistance_system
POSTGRES_USER=literature_assistance_system
POSTGRES_PASSWORD=literature_assistance_system
POSTGRES_PORT=55432
STORAGE_ROOT=runtime/storage

# 2. Website access
# Use one hostname consistently. Public deployments require HTTPS and secure cookies.
FRONTEND_PUBLIC_URL=http://127.0.0.1:5173
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# 3. Account security and session lifetimes
AUTH_COOKIE_SECURE=true
AUTH_SESSION_TTL_SECONDS=604800
AUTH_VERIFY_TTL_SECONDS=86400
AUTH_RESET_TTL_SECONDS=1800
# Required for accounts: generate two independent secrets, each at least 32 UTF-8 bytes.
AUTH_RATE_KEY=
AUTH_CSRF_KEY=

# 4. Registration and password-reset email
# SSL/TLS on port 465; username and From must match.
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
# Mailbox SMTP authorization code, not the mailbox login password.
SMTP_AUTH_CODE=
SMTP_FROM=
SMTP_TIMEOUT_SECONDS=15
# Independent Fernet key; keep stable while encrypted mail remains queued.
MAIL_OUTBOX_KEY=

# 5. Task monitoring and PDF parsing
TASK_MONITOR_ENABLED=true
PARSER_TIMEOUT_SECONDS=120

# 6. Agent dispatch and result exchange
# Configure the selected transport and start the research Worker before enabling.
# manual: external exchange; local: local process; tcloud: course CPU jobs; tacc: SSH/Slurm.
TASK_RUNNER=agent
AGENT_DISPATCH_ENABLED=true
AGENT_TRANSPORT=manual
# Empty: STORAGE_ROOT/agent-exchange; relative paths resolve from backend/.
AGENT_EXCHANGE_ROOT=
# HTTPS library origin accessible from the job; blank for exchange-only operation.
AGENT_LIBRARY_PUBLIC_URL=
AGENT_TRANSPORT_TIMEOUT_SECONDS=30
AGENT_POLL_SECONDS=2
AGENT_RESULT_MAX_BYTES=16777216
# Cleanup is explicit; minimum retention is one day, default seven days.
AGENT_RETENTION_SECONDS=604800

# 7. Transport-specific settings
# TCloud: initialized course SDK; private model/embedding dotenv stays on the Worker.
AGENT_TCLOUD_CLI=tcloud
AGENT_TCLOUD_ENV_NAME=acs-network-probe
# Includes file synchronization and environment preparation before sbatch.
AGENT_TCLOUD_SUBMIT_TIMEOUT_SECONDS=180
AGENT_TCLOUD_MODEL_ENV_FILE=

# Local: paths relative to backend/; use the Agent's own Python 3.12 environment.
# Windows: ../agent/.venv/Scripts/python.exe; macOS/Linux: ../agent/.venv/bin/python.
AGENT_LOCAL_ROOT=../agent
AGENT_LOCAL_PYTHON=python3

# Historical SSH/Slurm: SSH alias and absolute remote helper/config paths.
AGENT_TACC_HOST=
AGENT_TACC_HELPER=
AGENT_TACC_CONFIG=
# Set an absolute interpreter path if the remote python3 is older than 3.11.
AGENT_TACC_PYTHON=python3

# 8. Research budgets
# Main-model output is per request; task steps/time also depend on paper count.
# See README.md#agent-dispatch for the output/context tradeoff and TACC limits.
AGENT_MAX_STEPS=200
AGENT_TIMEOUT_SECONDS=1800
AGENT_OUTPUT_TOKENS=16384
AGENT_CONTEXT_TOKENS=32000
AGENT_SEARCH_MAX_PAPERS=20

# 9. Optional Agent persistence
# Separate Agent database; leave disabled unless its persistence service is configured.
AGENT_PERSIST=false
AGENT_PERSIST_DATABASE_URL=

# 10. Per-user quotas
# Active quotas count queued/running work; the daily research quota uses UTC days.
USER_ACTIVE_TASKS=5
USER_ACTIVE_IMPORTS=5
USER_DAILY_TASKS=100

# 11. Paper search and import
# arXiv search/import requires a contact email and the Import Worker for downloads.
ARXIV_ENABLED=true
ARXIV_CONTACT_EMAIL=
# Optional: enables the Agent's external search proxy.
TAVILY_API_KEY=

# 12. DeepSeek result evaluation
# Enable only after filling an available model ID/key and starting the evaluation Worker.
# These budgets are independent of Agent research; see README.md#deepseek-evaluation.
EVALUATION_ENABLED=true
EVALUATION_BASE_URL=https://api.deepseek.com
EVALUATION_MODEL=deepseek-flash
EVALUATION_API_KEY=
EVALUATION_TIMEOUT_SECONDS=180
EVALUATION_MAX_OUTPUT_TOKENS=16384
EVALUATION_MAX_INPUT_BYTES=256000
EVALUATION_MAX_RESPONSE_BYTES=262144
EVALUATION_MAX_ATTEMPTS=3
EVALUATION_DAILY_LIMIT=50
EVALUATION_EVIDENCE_TIMEOUT_SECONDS=60
