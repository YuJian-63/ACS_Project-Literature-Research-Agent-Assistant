# Copy to frontend/.env.local when overriding these defaults.
# VITE_* values are public browser configuration: never put API keys or secrets here.

# 1. Browser API origin (applies to development and production builds)
# Empty: same-origin /api requests through the Vite proxy or production reverse proxy.
# For a separate API origin, use https://api.example.com without an /api suffix;
# also configure backend CORS, FRONTEND_PUBLIC_URL and session cookies.
VITE_API_BASE_URL=

# 2. Development/preview proxy (Vite server only)
# Used when VITE_API_BASE_URL is empty; production hosting uses its own reverse proxy.
API_PROXY_TARGET=http://127.0.0.1:8000
